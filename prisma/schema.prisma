generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(uuid())
  name                String
  email               String              @unique
  password            String
  phone               String?
  document            String?             @unique
  accountType         String?
  role                String              @default("user")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  classifieds         Classified[]
  muralPosts          MuralPost[]
  donations           Donation[]
  listings            ListingProfile[]
  marketplaceListings Listing[]
  propertyListings    PropertyListing[]
  animalListings      AnimalListing[]
  nfcTags             NfcTag[]
  botConfig           BotConfig?
  botTrades           BotTrade[]
  payments            Payment[]
  graduationEvents    GraduationEvent[]
  graduationStudents  GraduationStudent[]

  // --- Novas relações: Módulo Saúde Veicular ---
  vehicleListings     VehicleListing[]
  vehicleRecordsAdded VehicleHealthRecord[] @relation("RecordedBy")
  vehicleConsults     VehicleConsultationAudit[] @relation("ConsultedBy")
  partnerDealership   PartnerDealership?
  businessProfiles    BusinessProfile[]
  healthSubscriptions VehicleHealthSubscription[]
  easyBridgeProfile EasyBridgeUser?
}

model Classified {
  id         Int      @id @default(autoincrement())
  titulo     String
  descricao  String
  preco      Float
  categoria  String
  cidade     String
  estado     String
  fotos      String[]
  created_at DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model MuralPost {
  id         Int      @id @default(autoincrement())
  assunto    String
  conteudo   String
  categoria  String
  fotos      String[]
  created_at DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Donation {
  id         Int      @id @default(autoincrement())
  titulo     String
  descricao  String
  categoria  String
  cidade     String
  estado     String
  fotos      String[]
  created_at DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Category {
  id       Int        @id @default(autoincrement())
  nome     String
  parentId Int?
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")

  @@unique([nome, parentId])
  @@index([parentId])
}

model ListingProfile {
  id                 String   @id @default(uuid())
  tipoEntrada        String
  categoriaPrincipal String
  subcategoria       String?
  titulo             String
  descricao          String
  telefone           String?
  whatsapp           String?
  emailContato       String?
  facebook           String?
  instagram          String?
  estado             String
  cidade             String
  bairro             String?
  endereco           String?
  cep                String?
  destaque           Boolean  @default(false)
  plano              String   @default("base")
  qrEnabled          Boolean  @default(false)
  nfcEnabled         Boolean  @default(false)
  status             String   @default("ativo")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  userId             String?
  user               User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([categoriaPrincipal, subcategoria])
  @@index([estado, cidade])
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  category    String
  subcategory String
  state       String
  city        String
  images      String[]
  qrEnabled   Boolean  @default(false)
  nfcEnabled  Boolean  @default(false)
  ownerId     String
  createdAt   DateTime @default(now())
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([category])
  @@index([state])
  @@index([city])
}

model PropertyListing {
  id              String   @id @default(uuid())
  ownerId         String
  title           String
  description     String
  propertyType    String
  transactionType String
  price           Float
  state           String
  city            String
  neighborhood    String?
  address         String?
  cep             String?
  bedrooms        Int?
  bathrooms       Int?
  parkingSpots    Int?
  area            Float?
  images          String[]
  qrEnabled       Boolean  @default(false)
  nfcEnabled      Boolean  @default(false)
  publicCode      String   @unique
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([propertyType])
  @@index([state])
  @@index([city])
  @@index([publicCode])
}

model AnimalListing {
  id          String   @id @default(uuid())
  ownerId     String
  title       String
  description String
  animalType  String
  breed       String?
  sex         String?
  age         String?
  weight      Float?
  price       Float?
  state       String
  city        String
  tags        String[]
  images      String[]
  qrEnabled   Boolean  @default(false)
  nfcEnabled  Boolean  @default(false)
  publicCode  String   @unique
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([animalType])
  @@index([state])
  @@index([city])
  @@index([publicCode])
}

model NfcTag {
  id         String    @id @default(uuid())
  tagId      String    @unique
  targetId   String?
  targetType String?
  status     String    @default("active")
  ownerId    String?
  owner      User?     @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  scans      NfcScan[]

  @@index([ownerId])
  @@index([targetId])
}

model NfcScan {
  id        String   @id @default(uuid())
  tagId     String
  tag       NfcTag   @relation(fields: [tagId], references: [tagId], onDelete: Cascade)
  scannedAt DateTime @default(now())
  userAgent String?
  ipAddress String?

  @@index([tagId])
}

model BotConfig {
  id               String   @id @default(uuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  binanceApiKey    String?
  binanceApiSecret String?
  symbol           String   @default("SOL/USDT")
  tradeAmount      Float    @default(12.0)
  isActive         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

model BotTrade {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  asset     String
  type      String // "COMPRA" ou "VENDA"
  price     Float
  amount    Float
  value     Float
  profitPct String? // Lucro em percentual
  createdAt DateTime @default(now())

  @@index([userId])
}

model Payment {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Float
  mpId      String   @unique
  status    String   @default("pending")
  type      String   @default("subscription")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model GraduationEvent {
  id             String              @id @default(uuid())
  photographerId String
  photographer   User                @relation(fields: [photographerId], references: [id], onDelete: Cascade)
  name           String
  date           DateTime
  physicalGoal   Int                 @default(40)
  posterGoal     Int                 @default(2)
  digitalPrice   Float               @default(450.0)
  status         String              @default("active")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  students       GraduationStudent[]
  photos         GraduationPhoto[]

  @@index([photographerId])
}

model GraduationStudent {
  id        String              @id @default(uuid())
  eventId   String
  event     GraduationEvent     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  course    String?
  contract  GraduationContract?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([eventId])
  @@index([userId])
}

model GraduationPhoto {
  id              String          @id @default(uuid())
  eventId         String
  event           GraduationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  studentId       String?
  originalPath    String 
  watermarkedPath String
  isForAlbum      Boolean         @default(false)
  isForPoster     Boolean         @default(false)
  isPurchased     Boolean         @default(false)
  createdAt       DateTime        @default(now())

  @@index([eventId])
  @@index([studentId])
}

model GraduationContract {
  id                  String            @id @default(uuid())
  studentId           String            @unique
  student             GraduationStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)
  albumSelectedCount  Int               @default(0)
  posterSelectedCount Int               @default(0)
  physicalValue       Float
  digitalPurchased    Boolean           @default(false)
  digitalValue        Float             @default(0)
  status              String            @default("pending")
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}

// ==========================================
// NOVOS MODULOS CLIENTES (Supermercados, Sorveterias, Oficinas)
// ==========================================

model BusinessProfile {
  id              String   @id @default(uuid())
  ownerId         String
  owner           User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  businessType    String   
  name            String
  description     String?
  document        String?  @unique 

  address         String?
  city            String?
  state           String?

  phone           String?
  whatsapp        String?

  images          String[]
  qrEnabled       Boolean  @default(false)
  nfcEnabled      Boolean  @default(false)
  publicCode      String   @unique

  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([ownerId])
  @@index([businessType])
  @@index([publicCode])
}

model VehicleListing {
  id      String @id @default(uuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  vehicleType     String
  brand           String
  model           String
  year            Int
  plate           String? @unique
  chassisOrSerial String? @unique
  color           String?
  renavam         String?

  // Dados Adicionais do Proprietário (Aba 2)
  ownerName       String?
  ownerDocument   String?
  ownerPhone      String?
  ownerEmail      String?
  ownerCityState  String?

  publicCode String   @unique
  images     String[]
  videoUrl   String?
  nfcEnabled Boolean  @default(false)
  qrEnabled  Boolean  @default(false)
  nfcProvisioningStatus String @default("pending")

  isStolen      Boolean @default(false)
  isAuction     Boolean @default(false)
  isScrap       Boolean @default(false)
  judicialBlock Boolean @default(false)

  // Status de Ativação / Pagamento de R$ 1,00
  isPaid        Boolean @default(false)

  // Cliques / Ranking
  clicksFisicos  Int @default(0)
  clicksVirtuais Int @default(0)

  hideOwnerName Boolean @default(false)
  hidePlate     Boolean @default(false)

  forSale Boolean @default(false)
  price   Float?

  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  healthRecords VehicleHealthRecord[]
  consultations VehicleConsultationAudit[]
  healthSubscription VehicleHealthSubscription?

  @@index([ownerId])
  @@index([vehicleType])
  @@index([publicCode])
  @@index([plate])
}

model VehicleHealthRecord {
  id        String         @id @default(uuid())
  vehicleId String
  vehicle   VehicleListing @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  recordedById   String
  recordedBy     User    @relation("RecordedBy", fields: [recordedById], references: [id])
  isVerifiedShop Boolean @default(false)

  serviceType String
  description String
  mileage     Int?
  serviceDate DateTime
  documents   String[]

  // Detalhes da Revisão / Checklist (JET Lubrificantes Avançado)
  oilType                   String?
  oilChangeMotor            Boolean @default(false)
  oilChangeCambioManual     Boolean @default(false)
  oilChangeCambioAutomatico Boolean @default(false)
  kmProximaTroca            Int?
  filterAr                  Boolean @default(false)
  filterOleoMotor           Boolean @default(false)
  filterOleoCambio          Boolean @default(false)
  warrantyServices          Boolean @default(false)
  warrantyParts             Boolean @default(false)
  partsReplaced             String?
  videoUrl                  String?

  createdAt DateTime @default(now())

  @@index([vehicleId])
  @@index([recordedById])
}

model PartnerDealership {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyName String
  cnpj        String @unique
  address     String
  city        String
  state       String

  subscriptionPlan String  @default("basic")
  isActive         Boolean @default(true)
  isHealthCarAccredited Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VehicleConsultationAudit {
  id                String   @id @default(uuid())
  vehicleId         String
  vehicle           VehicleListing @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  
  consultedById     String
  consultedBy       User     @relation("ConsultedBy", fields: [consultedById], references: [id])
  
  legalTermAccepted Boolean  @default(true) 
  termVersion       String   @default("v1.0")
  feeCharged        Float    @default(0.0) 
  ipAddress         String?
  
  consultedAt       DateTime @default(now())

  @@index([vehicleId])
  @@index([consultedById])
}

// ==========================================
// NOVO MODULO: REDE SAUDE CAR (Planos)
// ==========================================

model HealthPlan {
  id          String   @id @default(uuid())
  name        String   
  description String
  priceMensal Float
  priceAnual  Float
  features    String[] 
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  subscriptions VehicleHealthSubscription[]
}

model VehicleHealthSubscription {
  id          String   @id @default(uuid())
  vehicleId   String   @unique
  vehicle     VehicleListing @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String
  plan        HealthPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  status      String   @default("active") 
  paymentType String   
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([vehicleId])
  @@index([planId])
}

// ==========================================
// MÓDULO: BROCH EASYBRIDGE EN (Aprendizado de Inglês)
// ==========================================

model EasyBridgeUser {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp             Int      @default(0)
  level          Int      @default(1)
  wordsLearned   Int      @default(0)
  quizzesDone    Int      @default(0)
  streakCurrent  Int      @default(0)
  streakLongest  Int      @default(0)
  streakLastDate DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  completedLessons EasyBridgeLesson[]

  @@index([userId])
}

model EasyBridgeLesson {
  id               Int              @id @default(autoincrement())
  easyBridgeUserId String
  easyBridgeUser   EasyBridgeUser   @relation(fields: [easyBridgeUserId], references: [id], onDelete: Cascade)
  categoryId       String
  wordPt           String
  wordEn           String
  completedAt      DateTime         @default(now())

  @@index([easyBridgeUserId])
  @@index([categoryId])
}
